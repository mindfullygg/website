# ============================================================
# mindfully.gg — Environment Variables
# Copy to .env.local and fill in. .env.local is gitignored.
# ============================================================

# --- Upstash Redis — https://console.upstash.com ---
# If you add Upstash through the Vercel marketplace it injects
# KV_REST_API_URL / KV_REST_API_TOKEN instead; lib/kv.ts reads either pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Encryption ---
# AES-256-GCM key used to encrypt creator API keys at rest.
# Must decode to exactly 32 bytes. Base64 or hex both work.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Clerk auth — https://dashboard.clerk.com ---
# Identity + sessions for the creator dashboard. Placeholder-safe:
# the app compiles without real keys, but sign-in only works once set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Bot process (bot/start.ts, runs separately from Next.js) ---
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Machine-to-machine secrets ---
# Protects the Vercel cron that triggers the daily digest.
CRON_SECRET=
# Shared secret for server-to-server orchestrator HTTP routes
# (message / member-join) so they can't be called by the public.
ORCHESTRATOR_SECRET=

# --- Minds Builder key (developer scripts only) ---
# Your own Minds API key, used by scripts/ to inspect Minds and run Skill
# evals against them. The app itself never reads this: each creator's key is
# supplied at setup, encrypted with ENCRYPTION_KEY and stored per account.
# Needed for: check-minds.ts, check-conversation.ts, eval-skill.ts
MINDS_BUILDER_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
